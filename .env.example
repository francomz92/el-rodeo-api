# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT="development"

# ── API ──────────────────────────────────────────────────────────────────────
TERM_OF_SERVICE_URL="https://el-rodeo-api.com/terms-of-service"
ALLOWED_ORIGINS=["http://localhost:5173"]
ALLOWED_HEADERS=["*"]
TRUSTED_HOSTS=["*"]
DOMAIN="http://127.0.0.1:7000"

# ── Database ─────────────────────────────────────────────────────────────────
DB_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/el_rodeo"

# ── JWT / Auth ───────────────────────────────────────────────────────────────
SECRET="change-me-to-a-secure-random-secret"
JWT_ALGORITHM="HS256"

# ── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# ── S3-compatible File Storage ───────────────────────────────────────────────
S3_BUCKET="el-rodeo-dev"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_ENDPOINT="http://127.0.0.1:9000"     # MinIO endpoint for local dev

# ── Redis / Celery ───────────────────────────────────────────────────────────
BROKER_URL="redis://127.0.0.1:6380/0"
RESULT_BACKEND_URL="redis://127.0.0.1:6380/0"
REDIS_URL="redis://127.0.0.1:6380/0"

# ── Security / Rate Limiting (dev defaults) ────────────────────────────────
COOKIE_DOMAIN=""
COOKIE_SECURE=false
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_REGISTER="3/minute"
RATE_LIMIT_PASSWORD_CHANGE="3/minute"
RATE_LIMIT_REFRESH="10/minute"
CSP_DEFAULT_SRC="'self'"
HSTS_MAX_AGE=31536000
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Billing / MercadoPago ──────────────────────────────────────────────────
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MP_WEBHOOK_URL=""
FRONTEND_URL="http://localhost:3000"
